<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.candy.tools"
    android:versionCode="166"
    android:versionName="14.5">

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:screenOrientation="portrait" />
        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:label="@string/help_title"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ToolsActivity"
            android:exported="false"
            android:label="@string/egg_title"
            android:screenOrientation="portrait" />
        <activity android:name=".ClipboardActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".WakeLockActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".SystemMonitorActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".HostsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".NetworkWakeActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PermissionHubActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PermBackupActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PermRestoreActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".AppOpsListActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".BackupActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".RestoreActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".AppControlActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".NetworkActivity" android:exported="false" android:screenOrientation="portrait" />
    </application>
</manifest>



















